  1172                        ; CHKSPCL
  1173                        ;
  1174                        ; CHECK CURRENT OPCODE (IN CODE) FOR SPECIAL CASES
  1175                        ; INSTRUCTIONS WHICH TRANSFER CONTROL (JMP, BRA, ETC.)
  1176                        ;
  1177                        ; ASSUMES SHORTA, LONGI CALLED BY EBRKIN
  1178                        ; --------------------------------------------L
  1179                        ;
  1180                        
  1181                        CHKSPCL:;	sep	#M
  1182                        		longa off
  1183                        		rep	#IX
  1184                        		longi on
  1185                        
  1186                        		ldx	#SCX-SCODES
  1187                        		txa			; clear B (SCX-SCODES < 256)
  1188                        		lda	CODE1
  1189                        
  1190                        LOOP:		cmp	SCODES,X	; CHECK TO SEE IF CURRENT OPCODE
  1191                        		beq	HIT		; IS IN EXCEPTION TABLE
  1192                        		dex
  1193                        		bpl	LOOP
  1194                        		rts			; EXIT IF NOT
  1195                        
  1196                        HIT:		txa			; IF INDEX WAS LESS THAN 9, IT'S
  1197                        		cmp	#9		; A BRANCH
  1198                        		bcs	NOTBR
  1199                        			
  1200                        		lsr	A		; SEE IF ‘ODD OR EVEN'
  1201                        		tax	
  1202                        		lda	PMASK,X		; GET MASK TO SELECT CORRECT
  1203                        					; PREG BIT
  1204                        		and	PREG		; IS IT SET?
  1205                        			
  1206                        		bcs	BBS		; IF INDEX WAS ODD, BRANCH IF
  1207                        					; PREG BIT IS SET
  Tue Oct  6 2026 15:25                                                                                                    Page 22


  1208                        		beq	DOBRANCH	; ELSE IF EVEN, BRANCH IF CLEAR
  1209                        		rts
  1210                        
  1211                        BBS:		bne	DOBRANCH	; "BRANCH IF BIT SET"
  1212                        		rts
  1213                        
  1214                        NOTBR:		asl	A		; NOT A BRANCH INSTRUCTION;
  1215                        					; MULTIPLY BY TWO
  1216                        		tax			; AND INDEX INTO HANDLER JUMP
  1217                        					; TABLE
  1218                        ;		rep	#IX
  1219                        		jmp	(SPJMP-18,X)	; BIAS JUMP TABLE BY 9
  1220                        
  1221                        DOBRANCH:
  1222                        		lda	#$FF		; SET ACCUMULATOR BYTE HIGH
  1223                        					; (ANTICIPATE NEGATIVE)
  1224                        		xba			; AND SIGN EXTEND INTO X
  1225                        
  1226                        		lda	OPRNDL
  1227                        ;		jsr	printhex
  1228                        		
  1229                        		rep	#M+IX+C		; MAKE REGS LONG; CLEAR CARRY
  1230                        		longa on			; (ANTICIPATE ADC)
  1231                        		longi on
  1232                        
  1233                        		bmi	OK1		; NUMBER WAS NEGATIVE; ALL IS OK
  1234                        		
  1235                        		and	#$7F		; CLEAR HIGH BYTE OF ACCUM
  1236                        					; (POSITIVE NUMBER)
  1237                        OK1:		
  1238                        		adc	PCREG
  1239                        		sta	PCREG
  1240                        		
  1241                        		SEP	#M+IX
  1242                        		longa off
  1243                        		longi off
  1244                        		
  1245                        ;		jsr	printhex
  1246                        ;		xba
  1247                        ;		jsr	printhex
  1248                        		
  1249                        		SEP	#M		; RETURN WITH ACCUM SHORT
  1250                        		rts
  1251                        
  1252                        		ENDIF
  1253                        		
  1254                        		longa off
  1255                        		longi on
