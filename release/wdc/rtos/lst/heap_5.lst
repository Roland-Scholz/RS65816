    34                        ;/*
    35                        ; * A sample implementation of pvPortMalloc() that allows the heap to be defined
    36                        ; * across multiple non-contiguous blocks and combines (coalescences) adjacent
    37                        ; * memory blocks as they are freed.
    38                        ; *
    39                        ; * See heap_1.c, heap_2.c, heap_3.c and heap_4.c for alternative
    40                        ; * implementations, and the memory management pages of https://www.FreeRTOS.org
    41                        ; * for more information.
    42                        ; *
    43                        ; * Usage notes:
    44                        ; *
    45                        ; * vPortDefineHeapRegions() ***must*** be called before pvPortMalloc().
    46                        ; * pvPortMalloc() will be called if any task objects (tasks, queues, event
    47                        ; * groups, etc.) are created, therefore vPortDefineHeapRegions() ***must*** be
    48                        ; * called before any other objects are defined.
    49                        ; *
    50                        ; * vPortDefineHeapRegions() takes a single parameter.  The parameter is an array
    51                        ; * of HeapRegion_t structures.  HeapRegion_t is defined in portable.h as
    52                        ; *
  Sun Sep 20 2026 12:03                                                                                                    Page 2


    53                        ; * typedef struct HeapRegion
    54                        ; * {
    55                        ; *  uint8_t *pucStartAddress; << Start address of a block of memory that will be part of the heap.
    56                        ; *  size_t xSizeInBytes;      << Size of the block of memory.
    57                        ; * } HeapRegion_t;
    58                        ; *
    59                        ; * The array is terminated using a NULL zero sized region definition, and the
    60                        ; * memory regions defined in the array ***must*** appear in address order from
    61                        ; * low address to high address.  So the following is a valid example of how
    62                        ; * to use the function.
    63                        ; *
    64                        ; * HeapRegion_t xHeapRegions[] =
    65                        ; * {
    66                        ; *  { ( uint8_t * ) 0x80000000UL, 0x10000 }, << Defines a block of 0x10000 bytes starting at address 
                    0x80000000
    67                        ; *  { ( uint8_t * ) 0x90000000UL, 0xa0000 }, << Defines a block of 0xa0000 bytes starting at address 
                    of 0x90000000
    68                        ; *  { NULL, 0 }                << Terminates the array.
    69                        ; * };
    70                        ; *
    71                        ; * vPortDefineHeapRegions( xHeapRegions ); << Pass the array into vPortDefineHeapRegions().
    72                        ; *
    73                        ; * Note 0x80000000 is the lower address so appears in the array first.
    74                        ; *
    75                        ; */
